# Entorno de Django
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-this-with-a-generated-secret-key

# Hosts permitidos
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Base de datos MySQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Orígenes confiables para CSRF (solo si son necesarios)
CSRF_TRUSTED_ORIGINS=
